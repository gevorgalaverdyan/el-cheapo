# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Every variable here maps to a field on Settings in elcheapo/config.py.

# ---------------------------------------------------------------------------
# Required to run locally
# ---------------------------------------------------------------------------

# From @BotFather in Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated Telegram chat ids allowed to use the bot, no spaces needed.
# Find yours with: uv run python -m elcheapo.whoami  (or message @userinfobot)
# Group chat ids are negative -- that is normal.
# Leave this empty and the bot answers ANYONE who finds it, spending your quota.
ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Locale -- decides what "yesterday" means and how amounts are displayed
# ---------------------------------------------------------------------------

CURRENCY=CAD

# IANA timezone. Canada: America/Toronto | America/Vancouver | America/Edmonton
#                        America/Winnipeg | America/Halifax | America/St_Johns
TIMEZONE=America/Toronto

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Pin an explicit version rather than a *-latest alias, which can shift under
# you. List what your key can use with: uv run python -m elcheapo.list_models
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Not needed yet -- for Google Sheets and the Cloud Run deploy
# ---------------------------------------------------------------------------

# Created by: uv run python -m elcheapo.sheets.bootstrap
SPREADSHEET_ID=

# Any long random string; must match what you pass to Telegram setWebhook.
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unused by the local polling loop, required by the deployed webhook.
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Set TRUE on Cloud Run to use Vertex AI instead of an API key -- keyless,
# authenticated by the runtime service account. Leave unset locally.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
