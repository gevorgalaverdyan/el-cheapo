# Copy to .env and fill in. .env is gitignored -- never commit real values.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string. Must match what you pass to setWebhook.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram chat ids permitted to use the bot.
# Get yours from @userinfobot. This is the entire access-control model.
ALLOWED_CHAT_IDS=

# Created by: uv run python -m elcheapo.sheets.bootstrap
SPREADSHEET_ID=


# Vertex AI (keyless via Application Default Credentials)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.5-flash-lite
