# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- required ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Comma-separated. Find yours: uv run python -m elcheapo.whoami
ALLOWED_CHAT_IDS=

# --- storage ----------------------------------------------------------
# Local Postgres: docker compose up -d && uv run python -m elcheapo.seed
DATABASE_URL=postgresql+pg8000://elcheapo:elcheapo@127.0.0.1:5433/elcheapo

# --- locale -----------------------------------------------------------
CURRENCY=CAD
TIMEZONE=America/Toronto

# --- agent ------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite
# Minutes of silence before a chat starts a fresh conversation. /reset also works.
SESSION_IDLE_MINUTES=15

# --- deals ------------------------------------------------------------
# parse.bot key for the Flipp weekly-ad API. Leave empty to turn the
# deal tools off. https://parse.bot/marketplace -- free tier: 200 credits,
# 5 requests a minute, one credit per call.
FLIPP_API=

# --- not used yet -----------------------------------------------------
# Deployed webhook only; the local polling loop ignores these.
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
